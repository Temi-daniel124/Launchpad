{
  "expo": {
    "name": "Launchpad",
    "slug": "launchpad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080E1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vooltgroup.launchpad",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for profile photo",
        "NSPhotoLibraryUsageDescription": "Used to select profile photo",
        "NSFaceIDUsageDescription": "Used for secure app unlock",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080E1A"
      },
      "package": "com.vooltgroup.launchpad",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications"
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Launchpad to use Face ID for secure access."
        }
      ]
    ],
    "scheme": "com.vooltgroup.launchpad",
    "owner": "danielibukun124",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6fb3a59-0592-4ee9-bb01-1ef3c6220a5d"
      }
    }
  }
}
